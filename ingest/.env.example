SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# uuid of a dedicated auth.users row for this service — create one in the
# Supabase Dashboard (Authentication > Users), no login needed. Used as
# documents.owner_id for harvested unstructured files.
INGEST_OWNER_USER_ID=
POLL_INTERVAL_S=300

# Folder watch — off if unset. One subfolder per division code directly
# under this path, e.g. WATCH_ROOT\CMPD\monthly-report.xlsx
WATCH_ROOT=

# Mail-in — off unless all three of IMAP_HOST/IMAP_USER/IMAP_PASSWORD are set.
# Needs an institute IT-provisioned mailbox (design doc open question).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
