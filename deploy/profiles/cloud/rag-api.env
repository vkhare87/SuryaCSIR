# cloud — query API. Copy to rag/.env.api, fill secrets, do NOT commit.
# CORS_ORIGINS only needed if the SPA is hosted on a different origin than the API
# (e.g. static host + separate API VM). Leave blank if nginx puts them same-origin.
SUPABASE_URL=
SUPABASE_ANON_KEY=
LLM_BACKEND=openllm
OPENLLM_BASE_URL=
OPENLLM_MODEL=qwen3-vl:8b
CORS_ORIGINS=
