# laptop demo — query API. Copy to rag/.env.api, fill secrets, do NOT commit.
# CORS_ORIGINS needed because the Vite dev server (:5173) and uvicorn (:8000)
# are different origins on a laptop demo — prod doesn't need this (same-origin nginx).
SUPABASE_URL=
SUPABASE_ANON_KEY=
LLM_BACKEND=openllm
OPENLLM_BASE_URL=http://localhost:11434/v1
OPENLLM_MODEL=qwen3-vl:8b
CORS_ORIGINS=http://localhost:5173
