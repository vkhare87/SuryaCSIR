# institute server — ingestion worker. Copy to rag/.env, fill secrets, do NOT commit.
# SUPABASE_URL points at the self-hosted Kong gateway, not cloud.
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
LLM_BACKEND=openllm
OPENLLM_BASE_URL=http://localhost:11434/v1
OPENLLM_MODEL=qwen3-vl:32b
OCR_BACKEND=ollama
POLL_INTERVAL_S=30
BATCH_SIZE=5
