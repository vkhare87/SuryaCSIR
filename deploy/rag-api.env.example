# surya-rag-api — query endpoint. No service key here on purpose:
# the API reads with the caller's JWT so RLS scopes everything.
SUPABASE_URL=
SUPABASE_ANON_KEY=
LLM_BACKEND=openllm
# Switching model hosts is a provider name plus a key: LLM_PROVIDER=ollama (local,
# no key) or deepseek (hosted, needs OPENLLM_API_KEY). The base URL and a default
# model come with the preset. Any other OpenAI-compatible provider works too — leave
# LLM_PROVIDER unset and give OPENLLM_BASE_URL + OPENLLM_MODEL directly.
LLM_PROVIDER=ollama
# Override the preset's model only if you run a different one:
# OPENLLM_MODEL=
# OPENLLM_BASE_URL=

# Per-call timeouts. Defaults (10/20/60s) assume the model is GPU-served. A
# CPU-only host runs an 8B model at roughly 50-100s per call, so every query
# would time out; raise these to match the host before going live.
RAG_ROUTE_TIMEOUT_S=180
RAG_PICK_TIMEOUT_S=180
RAG_ANSWER_TIMEOUT_S=180

# Hosted OpenAI-compatible API instead of the local model (development only —
# institute text leaves the network). Point BASE_URL/MODEL at the provider and
# set the key; leave unset for local hosting.
# OPENLLM_API_KEY=
