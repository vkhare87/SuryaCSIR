# surya-rag-worker — ingestion. Needs the service key (bypasses RLS) to drain the
# documents queue and write doc_indexes. Keep this file off the API process.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
LLM_BACKEND=openllm
# See rag-api.env.example: LLM_PROVIDER=ollama | deepseek, or set
# OPENLLM_BASE_URL + OPENLLM_MODEL for any other OpenAI-compatible host.
LLM_PROVIDER=ollama
# OPENLLM_MODEL=
# OPENLLM_API_KEY=
# ollama = vision OCR via the same Ollama server (model from OCR_MODEL, defaults
# to OPENLLM_MODEL). tesseract needs the Tesseract binary on the host.
OCR_BACKEND=ollama
POLL_INTERVAL_S=30
BATCH_SIZE=5

# Ingestion is a batch job, so it can tolerate a slow local model.
RAG_SUMMARIZE_TIMEOUT_S=600

# Keeps page images on the local vision model even when OPENLLM_BASE_URL points
# at a hosted API — scanned pages then never leave the host.
OCR_BASE_URL=http://localhost:11434/v1
OCR_MODEL=qwen3-vl:8b
